# A USB drive plugged into the box: opened read-only for SoundStorm to bring
# its media in from (usb.sh, httpapi/drives.go). Each partition with a
# filesystem gets a soundstorm-usb@ unit, which goes when the drive does.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", TAG+="systemd", ENV{SYSTEMD_WANTS}+="soundstorm-usb@%k.service"
