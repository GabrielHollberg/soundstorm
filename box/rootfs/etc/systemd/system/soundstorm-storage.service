[Unit]
# After the data drive's own line in fstab has been tried (nofail: local-fs
# does not wait for it), or storage.sh could mount it a second time over it.
After=srv-soundstorm.mount
Description=SoundStorm data drive
# Before Docker: the volumes are folders on the drive, and a container
# started without them would write to the system disk underneath.
Before=docker.service soundstorm.service
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Preparing a new data drive, or waiting for one that is slow, must not be
# cut short and started again on every boot.
TimeoutStartSec=infinity
ExecStart=/usr/local/lib/soundstorm/storage.sh

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
