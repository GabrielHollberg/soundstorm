[Unit]
Description=SoundStorm USB drive %I
# Stopped - and so unmounted - when the drive is pulled out.
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# Noticed only: the caretaker opens it once the owner says so in the app.
ExecStart=/usr/local/lib/soundstorm/usb.sh seen %I
ExecStop=/usr/local/lib/soundstorm/usb.sh unmount %I
