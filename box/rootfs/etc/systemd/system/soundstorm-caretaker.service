[Unit]
Description=SoundStorm caretaker (updates)
# Not after EmberStorm, and not needing Docker: the power button is read
# here, and it must work from the first moments of a box's first start
# (loading its programs takes minutes) and when the data drive or Docker has
# failed - shutting down and the password reset are what is left then (the
# blind reviews, 2026-10-10). Not even after Docker, which waits for the data
# drive (being prepared the first time can take a while). Updates and resets
# ask Docker when they run.
Wants=docker.service
# A caretaker an update brought that will not stay up - five failures in five
# minutes - is replaced by the one before it (system.go keeps it as
# .previous), so a broken one cannot leave the box unable to update again.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=soundstorm-caretaker-restore.service

[Service]
# caretaker.env may point at another release channel (a development box).
EnvironmentFile=-/etc/soundstorm/caretaker.env
ExecStart=/usr/local/bin/soundstorm-caretaker serve
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
