[Unit]
Description=SoundStorm
After=docker.service network-online.target soundstorm-storage.service
Wants=network-online.target
Requires=docker.service soundstorm-storage.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The first start downloads every image; that takes as long as it takes.
TimeoutStartSec=0
ExecStartPre=/usr/local/lib/soundstorm/prepare.sh
ExecStart=/usr/local/lib/soundstorm/up.sh
# stop, never down -v: the volumes are people's accounts and settings.
ExecStop=/usr/bin/docker compose -f /opt/soundstorm/compose.yml -f /opt/soundstorm/compose.box.yml stop
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
