[Unit]
Description=SoundStorm
After=docker.service network-online.target soundstorm-storage.service soundstorm-images.service
Wants=network-online.target
# soundstorm-images too: started with images that did not load, compose
# tried for ever to download names that exist only on this box.
Requires=docker.service soundstorm-storage.service soundstorm-images.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A box built without its images downloads them on the first start, which
# takes as long as it takes.
TimeoutStartSec=0
ExecStartPre=/usr/local/lib/soundstorm/prepare.sh
ExecStart=/usr/local/lib/soundstorm/up.sh
ExecStop=/usr/local/lib/soundstorm/up.sh stop
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
