<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps music and audiobooks playing with the phone locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- Photo backup carries on when iOS chooses (PhotoBackup). -->
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.soundstorm.app.photobackup</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SoundStorm backs up your photos and videos to your own server, when you turn on photo backup in Settings.</string>
	<!-- Plain http only to the local network (IP addresses, .local names).
	     Everywhere else iOS insists on https, as the web app already does. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Only the system's own https, which is exempt: this answers App Store
	     Connect's export question once instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SoundStorm connects to your own server, which may be on your home network.</string>
</dict>
</plist>
