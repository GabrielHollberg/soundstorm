# The library folder structure IS committed - a fresh clone should already
# have somewhere to put media - but nothing anyone actually puts in it is.
/library/*/*
!/library/*/README.txt

# The old name for the same thing.
/media/

# Build output
/soundstorm
/soundstorm.exe
/out/
/dist/

# Local state when running outside a container
/state/
state.json

# Backups of it, which are the same secrets in a different file: the accounts
# and every backend password. The uninstaller writes one into the install
# folder, and on a development machine the install folder is this repository.
soundstorm-backup*.json
state.json.bak

# Go
*.test
*.out
coverage.*

# Editor and OS noise is covered by the global gitignore at
# C:\dev\.gitignore_global

# Per-install settings written by the installer: the chosen port, the TLS
# mode, an image override. Belongs to one machine, never to the repository.
.env

# Scratch programs for probing a live backend with the real adapter code. Handy
# and never worth committing; one slipped in once.
/tmpgen/

# Working directories for scripts/fetch-starter-media.sh. It cleans up after
# itself; this is for the run that gets interrupted.
/.starter-*/

# Xcode (ios/): per-person window layouts and build output
xcuserdata/
DerivedData/

# Gradle (android/): build output, its cache, and where this machine's SDK is
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml

# The after-deploy check: its browser library, and the throwaway test
# server's media (scripts/smoke-stack.sh).
/scripts/smoke/node_modules/
/scripts/smoke/package-lock.json
/.smoke/

# A YubiKey's public key as box/yubikey.py setup writes it; the ones boxes
# trust are copied into box/release.pub.
box/release-*.pub
