<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black from the first frame, so there is no white flash before the
         page paints; the dark system theme gives the dialogs their look. -->
    <style name="Theme.SoundStorm" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#6AA8FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
